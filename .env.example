# ---------------------------------------------------------------------------
# Collines Go — copiez ce fichier en .env, à côté du docker-compose.yml.
# ---------------------------------------------------------------------------

# Adresse publique de l'interface. C'est aussi un domaine court valide :
# go.collines.co/<slug> redirige comme n'importe quel autre.
CG_BASE_URL=https://go.collines.co

# Domaines courts, séparés par des virgules. Le premier est celui utilisé par
# défaut pour les nouveaux liens. Vous pourrez en ajouter d'autres depuis les
# réglages de l'interface, sans redémarrer.
CG_SHORT_DOMAINS=go.collines.co

# --- PocketID --------------------------------------------------------------
# Créez un client OAuth2 dans PocketID avec l'URL de redirection
#   https://go.collines.co/auth/callback
# puis autorisez les comptes qui doivent pouvoir créer des liens.
CG_OIDC_ISSUER=https://id.collines.co
CG_OIDC_CLIENT_ID=
CG_OIDC_CLIENT_SECRET=

# --- Sessions --------------------------------------------------------------
# 32 caractères aléatoires : openssl rand -hex 32
# S'il change, tout le monde est déconnecté (sans perte de liens).
CG_SESSION_KEY=

# --- Divers ----------------------------------------------------------------
# Laissez true derrière le proxy inverse de Synology : c'est ainsi que
# l'adresse du visiteur est lue pour limiter les tentatives de mot de passe.
# Elle n'est jamais enregistrée.
CG_TRUST_PROXY=true

TZ=Europe/Paris
