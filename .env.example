# Copiez ce fichier en .env et remplissez-le.

# L'adresse de l'interface. C'est aussi une redirection valide :
# go.collines.co/<slug> fonctionne comme n'importe quel autre domaine court.
CG_BASE_URL=https://go.collines.co

# Domaines courts supplémentaires, séparés par des virgules. Le premier est le
# domaine par défaut. Vous pouvez aussi en ajouter depuis les réglages.
# Chaque domaine doit pointer vers ce serveur et avoir son certificat.
CG_SHORT_DOMAINS=go.collines.co

# PocketID. Créez un client OAuth2 avec l'URL de redirection
#   https://go.collines.co/auth/callback
# et donnez-y accès aux comptes qui doivent pouvoir créer des liens.
CG_OIDC_ISSUER=https://id.collines.co
CG_OIDC_CLIENT_ID=
CG_OIDC_CLIENT_SECRET=

# openssl rand -hex 32
CG_SESSION_KEY=

# Laissez à true derrière un reverse proxy : c'est ainsi que l'adresse du
# visiteur est lue pour limiter les tentatives de mot de passe.
CG_TRUST_PROXY=true

TZ=Europe/Paris
