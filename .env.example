# ---------------------------------------------------------------------------
# Copy this file to .env, next to docker-compose.yml, and fill it in.
# ---------------------------------------------------------------------------

# Public address of the admin interface. It doubles as a short domain:
# links on this host redirect like any other.
CG_BASE_URL=https://go.example.com

# Short domains, comma separated. The first one is the default for new links.
# More can be added from the interface later, without a restart.
CG_SHORT_DOMAINS=go.example.com

# --- Identity provider (OIDC) ----------------------------------------------
# Any OIDC provider works: PocketID, Authentik, Keycloak, Auth0, Google...
# Create a confidential client whose redirect URL is
#   https://go.example.com/auth/callback
# and grant it to the accounts that should be able to create links. That grant
# is the only place authorisation lives: there are no accounts in this app.
CG_OIDC_ISSUER=https://id.example.com
CG_OIDC_CLIENT_ID=
CG_OIDC_CLIENT_SECRET=

# --- Sessions ---------------------------------------------------------------
# 32 random characters: openssl rand -hex 32
# Changing it signs everyone out. Links are unaffected.
CG_SESSION_KEY=

# --- Branding ---------------------------------------------------------------
# Put your own name on it. Both are optional; these are the defaults.
CG_BRAND_NAME=Wend
CG_TAGLINE=Short links, on your own domain.

# --- Language ---------------------------------------------------------------
# One language for the whole deployment: the interface, the messages the API
# sends back and the pages a visitor lands on. There is no per-user switch.
# Supported: en, fr. Anything else falls back to en.
CG_LANG=en

# --- Misc -------------------------------------------------------------------
# Leave true behind a reverse proxy: this is how the visitor's address is read
# to rate-limit password attempts. It is never stored.
CG_TRUST_PROXY=true

TZ=UTC
